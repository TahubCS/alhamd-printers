# PostgreSQL connection string used by Prisma (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Sign-in (required). Generate a secret with: openssl rand -base64 48
AUTH_SECRET=""
AUTH_USERNAME="admin"
AUTH_PASSWORD=""

# Set to "true" only on the public portfolio deployment to show the demo
# account on the login page. Never enable it for the real business install.
DEMO_MODE="false"

# Optional: enables AI-assisted purchase-order and receipt extraction
GOOGLE_GEMINI_API_KEY=""
# Optional model overrides. The escalation model re-reads a document only when
# the first reading fails its arithmetic checks; set it to "none" to disable.
# GEMINI_MODEL="gemini-3.5-flash-lite"
# GEMINI_ESCALATION_MODEL="gemini-3.8-flash"

# Optional: disposable database for integration tests (it is wiped on every run)
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/alhamd_test?schema=public"
