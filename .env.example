# PostgreSQL connection string used by Prisma (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional: enables AI-assisted purchase-order and receipt extraction
GOOGLE_GEMINI_API_KEY=""

# Optional: disposable database for integration tests (it is wiped on every run)
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/alhamd_test?schema=public"
