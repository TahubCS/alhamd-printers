// Prisma Schema for Al-Hamd Printers Business Management System
// Database: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// COMPANY - Multi-brand invoicing
// ============================================
model Company {
  id        String    @id @default(cuid())
  name      String // Al-Hamd Printers, ATS, M.A Enterprises, Muhammad Tanveer
  nameUrdu  String?
  address   String?
  phone     String?
  email     String?
  website   String?
  logoUrl   String? // URL to company logo for PDF
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
}

// ============================================
// CUSTOMER - with credit terms & ledger
// ============================================
model Customer {
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  nameUrdu               String?
  phone                  String?
  address                String?
  ntn                    String?
  gstNumber              String?
  email                  String?                 @unique
  creditLimit            Decimal?                @db.Decimal(15, 2)
  balance                Decimal                 @default(0) @db.Decimal(15, 2)
  isBadDebt              Boolean                 @default(false)
  // testField222  String?
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  customerPurchaseOrders CustomerPurchaseOrder[]
  invoices               Invoice[]
  ledgerEntries          LedgerEntry[]
  cheques                Cheque[]
  payments               Payment[]
  deliveryChallans       DeliveryChallan[]
  aliases                CustomerAlias[]
  productAliases         ProductAlias[]
}

// ============================================
// PRODUCT - PVC bag specifications
// ============================================
model Product {
  id                 String                      @id @default(cuid())
  code               String                      @unique
  name               String
  nameUrdu           String?
  description        String?
  thickness          String?
  withTape           Boolean                     @default(false)
  withPrint          Boolean                     @default(false)
  basePrice          Decimal                     @db.Decimal(10, 2)
  buttonPrice        Decimal                     @default(1) @db.Decimal(10, 2)
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  invoiceItems       InvoiceItem[]
  purchaseOrderItems CustomerPurchaseOrderItem[]
  aliases            ProductAlias[]
}

// ============================================
// INVOICE
// ============================================
model Invoice {
  id                      String                 @id @default(cuid())
  invoiceNo               Int                    @unique @default(autoincrement())
  date                    DateTime               @default(now())
  creditDays              Int                    @default(0)
  dueDate                 DateTime
  companyId               String
  company                 Company                @relation(fields: [companyId], references: [id])
  customerId              String
  customer                Customer               @relation(fields: [customerId], references: [id])
  customerPurchaseOrderId String?
  customerPurchaseOrder   CustomerPurchaseOrder? @relation(fields: [customerPurchaseOrderId], references: [id])
  items                   InvoiceItem[]
  subtotal                Decimal                @db.Decimal(15, 2)
  taxTotal                Decimal                @default(0) @db.Decimal(15, 2)
  total                   Decimal                @db.Decimal(15, 2)
  status                  InvoiceStatus          @default(PENDING)
  notes                   String?
  ledgerEntry             LedgerEntry?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  BAD_DEBT
}

// ============================================
// INVOICE ITEM - Line items on invoice
// ============================================
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  sizeWidth   Decimal? @db.Decimal(10, 2)
  sizeLength  Decimal? @db.Decimal(10, 2)
  sizeDepth   Decimal? @db.Decimal(10, 2)
  quantity    Int
  rate        Decimal  @db.Decimal(10, 2)
  gstRate     Decimal  @default(0) @db.Decimal(5, 2)
  amount      Decimal  @db.Decimal(15, 2)
}

// ============================================
// LEDGER ENTRY - Debit/Credit with running balance
// ============================================
model LedgerEntry {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  particulars String
  invoiceId   String?  @unique
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  paymentId   String?  @unique
  payment     Payment? @relation(fields: [paymentId], references: [id])
  debit       Decimal  @default(0) @db.Decimal(15, 2)
  credit      Decimal  @default(0) @db.Decimal(15, 2)
  balance     Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now())
}

// ============================================
// PAYMENT - Cash or Cheque
// ============================================
model Payment {
  id                 String        @id @default(cuid())
  date               DateTime      @default(now())
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id])
  amount             Decimal       @db.Decimal(15, 2)
  method             PaymentMethod
  // Bank Transfer Details
  bankAccountId      String?
  bankAccount        BankAccount?  @relation(fields: [bankAccountId], references: [id])
  senderBankName     String? // Bank name of the customer
  senderAccountTitle String? // Account title of the customer

  chequeId    String?      @unique
  cheque      Cheque?      @relation(fields: [chequeId], references: [id])
  notes       String?
  ledgerEntry LedgerEntry?
  createdAt   DateTime     @default(now())
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
}

// ============================================
// INVENTORY - Raw Materials
// ============================================

model RawMaterial {
  id                String                 @id @default(cuid())
  name              String                 @unique
  type              RawMaterialType
  attributes        Json? // Flexible attributes: thickness, quality, size
  quantity          Decimal                @default(0) @db.Decimal(15, 2)
  minimumStockLevel Decimal                @default(0) @db.Decimal(15, 2)
  transactions      InventoryTransaction[]
  purchaseItems     PurchaseOrderItem[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

enum RawMaterialType {
  ROLL
  HANGER
  BUTTON
  TAPE
  OTHER
}

model InventoryTransaction {
  id                      String                 @id @default(cuid())
  date                    DateTime               @default(now())
  materialId              String
  material                RawMaterial            @relation(fields: [materialId], references: [id])
  type                    TransactionType
  quantity                Decimal                @db.Decimal(15, 2) // + for IN, - for OUT (logic handled in code, or store absolute and use type)
  notes                   String?
  customerPurchaseOrderId String? // Link to PO (Usage)
  customerPurchaseOrder   CustomerPurchaseOrder? @relation(fields: [customerPurchaseOrderId], references: [id])
  purchaseOrderId         String? // Link to supplier PO (Receipt)
  purchaseOrder           PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
  createdAt               DateTime               @default(now())
}

enum TransactionType {
  IN // Purchase
  OUT // Usage
  ADJUSTMENT // Correction
}

// ============================================
// CHEQUE - with status tracking
// ============================================
model Cheque {
  id           String       @id @default(cuid())
  chequeNo     String
  bankName     String
  amount       Decimal      @db.Decimal(15, 2)
  chequeDate   DateTime
  receivedDate DateTime     @default(now())
  depositDate  DateTime?
  clearDate    DateTime?
  status       ChequeStatus @default(RECEIVED)
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id])
  payment      Payment?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum ChequeStatus {
  RECEIVED
  DEPOSITED
  CLEARED
  BOUNCED
}

// ============================================
// WORKER - with weekly wages
// ============================================
model Worker {
  id           String        @id @default(cuid())
  name         String
  nameUrdu     String?
  phone        String?
  weeklyWage   Decimal       @db.Decimal(10, 2)
  balance      Decimal       @default(0) @db.Decimal(15, 2)
  isActive     Boolean       @default(true)
  notes        String?
  wagePayments WagePayment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ============================================
// WAGE PAYMENT - payments to workers
// ============================================
model WagePayment {
  id        String   @id @default(cuid())
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id])
  date      DateTime @default(now())
  amount    Decimal  @db.Decimal(10, 2)
  type      WageType
  notes     String?
  createdAt DateTime @default(now())
}

enum WageType {
  PAYMENT
  ADVANCE
  DEDUCTION
  ADJUSTMENT
}

// ============================================
// SUPPLIER - for PVC rolls
// ============================================
model Supplier {
  id             String            @id @default(cuid())
  name           String
  nameUrdu       String?
  phone          String?
  address        String?
  balance        Decimal           @default(0) @db.Decimal(15, 2) // Amount we owe the supplier
  notes          String?
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// ============================================
// PURCHASE ORDER - buying raw materials
// ============================================
model PurchaseOrder {
  id                    String                 @id @default(cuid())
  poNumber              Int                    @unique @default(autoincrement())
  date                  DateTime               @default(now())
  supplierId            String
  supplier              Supplier               @relation(fields: [supplierId], references: [id])
  items                 PurchaseOrderItem[]
  total                 Decimal                @db.Decimal(15, 2)
  status                PurchaseStatus         @default(PENDING)
  notes                 String?
  inventoryTransactions InventoryTransaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

// ============================================
// PURCHASE ORDER ITEM
// ============================================
model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description      String
  specification    String?
  quantity         Int
  receivedQuantity Int           @default(0)
  rate             Decimal       @db.Decimal(10, 2)
  amount           Decimal       @db.Decimal(15, 2)
  materialId       String? // Received goods are added to this raw material's stock
  material         RawMaterial?  @relation(fields: [materialId], references: [id])
}

// ============================================
// SUPPLIER PAYMENT - money paid against the supplier balance
// ============================================
model SupplierPayment {
  id         String        @id @default(cuid())
  date       DateTime      @default(now())
  supplierId String
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  amount     Decimal       @db.Decimal(15, 2)
  method     PaymentMethod
  reference  String? // Cheque number or transfer reference
  notes      String?
  createdAt  DateTime      @default(now())
}

// ============================================
// CUSTOMER PURCHASE ORDER (Incoming POs)
// ============================================
model CustomerPurchaseOrder {
  id                    String                      @id @default(cuid())
  poNumber              String? // The customer's PO number
  date                  DateTime                    @default(now())
  customerId            String? // Optional because it might be a new customer during extraction
  customer              Customer?                   @relation(fields: [customerId], references: [id])
  subtotal              Decimal?                    @default(0) @db.Decimal(15, 2)
  taxTotal              Decimal?                    @default(0) @db.Decimal(15, 2)
  totalAmount           Decimal                     @default(0) @db.Decimal(15, 2)
  status                CustomerPOStatus            @default(DRAFT)
  originalFileUrl       String? // Path/URL to the uploaded file
  ocrText               String? // Raw text extracted if needed
  notes                 String? // Payment terms and special instructions from the PO
  items                 CustomerPurchaseOrderItem[]
  invoices              Invoice[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  inventoryTransactions InventoryTransaction[]
  deliveryChallans      DeliveryChallan[]
}

enum CustomerPOStatus {
  DRAFT // Extracted but not confirmed
  OPEN // Confirmed, waiting for invoice
  PARTIAL // Partially invoiced
  CLOSED // Fully invoiced
  REJECTED
}

model CustomerPurchaseOrderItem {
  id                      String                @id @default(cuid())
  customerPurchaseOrderId String
  customerPurchaseOrder   CustomerPurchaseOrder @relation(fields: [customerPurchaseOrderId], references: [id], onDelete: Cascade)
  description             String
  quantity                Int
  rate                    Decimal               @default(0) @db.Decimal(10, 2)
  gstRate                 Decimal               @default(0) @db.Decimal(5, 2)
  unit                    String?               @default("Pieces")
  amount                  Decimal               @default(0) @db.Decimal(15, 2)
  customAttributes        Json?                 @default("{}")
  productId               String?
  product                 Product?              @relation(fields: [productId], references: [id])
  deliveredItems          DeliveryChallanItem[]
}

// ============================================
// DELIVERY CHALLAN - goods dispatched to a customer
// ============================================
model DeliveryChallan {
  id                      String                 @id @default(cuid())
  challanNo               Int                    @unique @default(autoincrement())
  date                    DateTime               @default(now())
  customerId              String
  customer                Customer               @relation(fields: [customerId], references: [id])
  customerPurchaseOrderId String?
  customerPurchaseOrder   CustomerPurchaseOrder? @relation(fields: [customerPurchaseOrderId], references: [id])
  poNumber                String?
  vehicleNo               String?
  driverName              String?
  items                   DeliveryChallanItem[]
  notes                   String?
  createdAt               DateTime               @default(now())
}

model DeliveryChallanItem {
  id                          String                     @id @default(cuid())
  challanId                   String
  challan                     DeliveryChallan            @relation(fields: [challanId], references: [id], onDelete: Cascade)
  description                 String
  quantity                    Int
  unit                        String                     @default("Pieces")
  customerPurchaseOrderItemId String?
  customerPurchaseOrderItem   CustomerPurchaseOrderItem? @relation(fields: [customerPurchaseOrderItemId], references: [id])
}

// ============================================
// EXPENSE - Simple expense tracking
// ============================================
model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  amount      Decimal  @db.Decimal(15, 2)
  receiptUrl  String? // Optional: stored receipt image path
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// BANK ACCOUNT - Secure storage
// ============================================
model BankAccount {
  id                  String    @id @default(cuid())
  bankName            String // Display name: HBL, Meezan, etc.
  accountTitle        String // Al-Hamd Printers
  accountNumberMasked String // ****1234 (Last 4 digits only)
  // FULL ACCOUNT NUMBER IS NOT STORED IN DB FOR SECURITY
  isActive            Boolean   @default(true)
  payments            Payment[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ============================================
// LEARNED MATCHES - remembered from confirmed AI readings
// ============================================

// A customer name as printed on a document, confirmed to mean this customer
model CustomerAlias {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  normalizedName String   @unique
  name           String
  timesConfirmed Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([customerId])
}

// How one customer describes an item on their POs, confirmed to be this product
model ProductAlias {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  normalizedText String
  text           String
  timesConfirmed Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([customerId, normalizedText])
  @@index([productId])
}
